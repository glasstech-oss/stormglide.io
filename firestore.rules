rules_version = '2';

// Firestore is only accessed via the Cloud Functions Admin SDK (see functions/index.js),
// which bypasses these rules entirely. This file exists so the local emulator has
// something to load; it has no effect on production since no client SDK reads Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
